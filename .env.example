SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
PRIVACY_POLICY_URL=https://mobio.ikanisa.com/privacy-policy
ACCOUNT_DELETION_URL=https://mobio.ikanisa.com/account-deletion

# Public Firebase configuration. iOS release builds require FIREBASE_IOS_APP_ID.
# Keep server/admin credentials in CI secrets or Supabase Edge Function secrets only.
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_AUTH_DOMAIN=

# Android/Play release values are intentionally NOT stored here:
# KEYSTORE_BASE64, KEY_ALIAS, KEY_PASSWORD, STORE_PASSWORD,
# PLAY_STORE_SERVICE_ACCOUNT_JSON, SUPABASE_SERVICE_ROLE_KEY.
