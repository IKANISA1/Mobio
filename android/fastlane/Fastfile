default_platform(:android)

platform :android do
  desc "Build AAB with Supabase env vars from .env, then upload to Google Play (production draft)"
  lane :build_and_deploy do
    # Build via the release script — it sources .env and hard-fails if
    # SUPABASE_URL, SUPABASE_ANON_KEY, or PRIVACY_POLICY_URL are missing.
    sh("cd ../.. && ./scripts/release/build_android_release.sh appbundle")

    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      mapping: "../build/app/outputs/mapping/release/mapping.txt",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "draft",
    )
  end

  desc "Upload AAB, screenshots, metadata, and mapping to Google Play (production draft)"
  lane :deploy do
    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      mapping: "../build/app/outputs/mapping/release/mapping.txt",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "draft",
    )
  end

  desc "Upload metadata and screenshots only (no binary)"
  lane :metadata do
    upload_to_play_store(
      track: "production",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "draft",
    )
  end

  desc "Upload AAB only to internal track"
  lane :upload_aab do
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      mapping: "../build/app/outputs/mapping/release/mapping.txt",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft",
    )
  end

  desc "Promote internal to production"
  lane :promote_to_production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
