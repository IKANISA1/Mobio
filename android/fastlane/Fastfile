require "digest"
require "fileutils"
require "json"
require "open3"
require "tmpdir"

default_platform(:android)

def play_json_key_data
  ENV.fetch("PLAY_STORE_SERVICE_ACCOUNT_JSON") do
    UI.user_error!("Missing PLAY_STORE_SERVICE_ACCOUNT_JSON")
  end
end

def play_track
  track = ENV.fetch("PLAY_RELEASE_TRACK", "internal")
  allowed = %w[internal alpha beta production]
  UI.user_error!("PLAY_RELEASE_TRACK must be one of: #{allowed.join(', ')}") unless allowed.include?(track)

  require_production_approval! if track == "production"

  track
end

def require_production_approval!
  return if ENV.fetch("PLAY_PRODUCTION_APPROVED", "false") == "true"

  UI.user_error!("PLAY_PRODUCTION_APPROVED=true is required for production-track uploads")
end

def play_release_status
  status = ENV.fetch("PLAY_RELEASE_STATUS", "draft")
  allowed = %w[draft completed inProgress halted]
  UI.user_error!("PLAY_RELEASE_STATUS must be one of: #{allowed.join(', ')}") unless allowed.include?(status)
  status
end

def require_candidate_approval!(track, status)
  UI.user_error!("Approved artifacts must be used within the guarded upload block") unless block_given?
  root = File.expand_path("../..", __dir__)
  candidate = ENV["MOBIO_ANDROID_CANDIDATE_MANIFEST"]
  approval = ENV["MOBIO_ANDROID_RELEASE_APPROVAL"]
  if candidate.to_s.empty? || approval.to_s.empty?
    UI.user_error!("A candidate manifest and separate release approval are required before Google Play access")
  end

  aab = ENV.fetch("ANDROID_RELEASE_AAB", "build/app/outputs/bundle/release/app-release.aab")
  receipt_json, _verifier_error, verified = Open3.capture3(
    "python3", File.join(root, "scripts/release/android_candidate_manifest.py"),
    "--root", root, "verify", "--aab", File.expand_path(aab, root),
    "--candidate", File.expand_path(candidate, root),
    "--approval", File.expand_path(approval, root),
    "--track", track, "--release-status", status, "--package", "rw.mobi.app"
  )
  UI.user_error!("Artifact-bound release approval failed") unless verified.success?
  begin
    receipt = JSON.parse(receipt_json, max_nesting: 10)
  rescue JSON::ParserError
    UI.user_error!("Approved artifact verification receipt is unavailable")
  end
  unless receipt.is_a?(Hash) && receipt["status"] == "BOUND_APPROVAL_VERIFIED" &&
         receipt["track"] == track && receipt["artifact_sha256"].is_a?(String) &&
         /\A[0-9a-f]{64}\z/.match?(receipt["artifact_sha256"])
    UI.user_error!("Approved artifact verification receipt is unavailable")
  end

  staged_directory = Dir.mktmpdir("mobio-approved-aab-")
  begin
    staged_aab = File.join(staged_directory, "approved-release.aab")
    # Never upload the writable build path. Open without following a link, then
    # compare the private copy with the successful verifier's artifact digest.
    File.open(File.expand_path(aab, root), File::RDONLY | File::NOFOLLOW | File::NONBLOCK) do |source|
      UI.user_error!("Approved AAB must remain a regular file") unless source.stat.file?
      File.open(staged_aab, File::WRONLY | File::CREAT | File::EXCL, 0600) do |staged|
        IO.copy_stream(source, staged)
      end
    end
    unless Digest::SHA256.file(staged_aab).hexdigest == receipt["artifact_sha256"]
      UI.user_error!("Approved AAB changed after verification")
    end
    File.chmod(0444, staged_aab)
    yield staged_aab
  ensure
    FileUtils.remove_entry_secure(staged_directory)
  end
end

platform :android do
  desc "Retired: build a release candidate, review it, then use deploy"
  lane :build_and_deploy do
    UI.user_error!("Build-and-upload is disabled; create a candidate and obtain separate approval")
  end

  desc "Upload an approved AAB and mapping to Google Play"
  lane :deploy do
    target_track = play_track
    target_status = play_release_status
    require_candidate_approval!(target_track, target_status) do |approved_aab|
      upload_to_play_store(
        json_key_data: play_json_key_data,
        track: target_track,
        aab: approved_aab,
        mapping: "../build/app/outputs/mapping/release/mapping.txt",
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        release_status: target_status,
      )
    end
  end

  desc "Retired: metadata changes require a separate governed release path"
  lane :metadata do
    UI.user_error!("Metadata-only upload is disabled pending a separate approval path")
  end

  desc "Upload AAB only to internal track"
  lane :upload_aab do
    require_candidate_approval!("internal", "draft") do |approved_aab|
      upload_to_play_store(
        json_key_data: play_json_key_data,
        track: "internal",
        aab: approved_aab,
        mapping: "../build/app/outputs/mapping/release/mapping.txt",
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        release_status: "draft",
      )
    end
  end

  desc "Retired: promote by uploading the approved AAB through deploy"
  lane :promote_to_production do
    UI.user_error!("Direct promotion is disabled; use deploy with production-bound approval")
  end
end
