{
  "dart.flutterSdkPath": "/Users/jeanbosco/Developer/flutter",
  "dart.mcpServer": true,
  "dart.lineLength": 80,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.rulers": [
      80
    ]
  },
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true
  },
  "java.configuration.updateBuildConfiguration": "automatic",
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/output": true
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true,
    "**/output/**": true
  }
}
