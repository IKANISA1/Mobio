diff --git a/supabase/hardening/2026-09-28/01_booking_write_authority.sql b/supabase/hardening/2026-09-28/01_booking_write_authority.sql
new file mode 100644
index 0000000000000000000000000000000000000000..d7167f0d49d316e9278222262b97962bad29cf3d
--- /dev/null
+++ b/supabase/hardening/2026-09-28/01_booking_write_authority.sql
@@ -0,0 +1,28 @@
+-- Forward migration BODY. Generate a timestamp using the Supabase CLI installer.
+-- No historical migration is changed. Rehearse legitimate RPCs before deployment.
+begin;
+set local lock_timeout = '5s';
+set local statement_timeout = '30s';
+alter table public.bus_bookings enable row level security;
+revoke insert, update, delete, truncate on table public.bus_bookings from public, anon, authenticated;
+do $guard$
+declare columns_sql text; role_name text;
+begin
+  select string_agg(quote_ident(attname), ', ' order by attnum) into columns_sql
+  from pg_catalog.pg_attribute
+  where attrelid='public.bus_bookings'::regclass and attnum>0 and not attisdropped;
+  if columns_sql is null then raise exception 'BOOKING_SCHEMA_MISSING'; end if;
+  execute format('revoke insert (%s), update (%s) on table public.bus_bookings from public, anon, authenticated',columns_sql,columns_sql);
+  foreach role_name in array array['anon','authenticated'] loop
+    if pg_catalog.has_table_privilege(role_name,'public.bus_bookings','INSERT,UPDATE,DELETE,TRUNCATE')
+       or pg_catalog.has_any_column_privilege(role_name,'public.bus_bookings','INSERT')
+       or pg_catalog.has_any_column_privilege(role_name,'public.bus_bookings','UPDATE') then
+      raise exception 'BOOKING_WRITE_GRANT_REMAINS: %',role_name;
+    end if;
+  end loop;
+end;
+$guard$;
+drop policy if exists bus_bookings_update_owner_hold_or_agency on public.bus_bookings;
+-- SELECT policies/grants and authorized server RPCs are retained.
+notify pgrst, 'reload schema';
+commit;
diff --git a/supabase/hardening/2026-09-28/02_verified_phone_authority.sql b/supabase/hardening/2026-09-28/02_verified_phone_authority.sql
new file mode 100644
index 0000000000000000000000000000000000000000..e055d494698ee96610b5a52b2c8b08598c4b673c
--- /dev/null
+++ b/supabase/hardening/2026-09-28/02_verified_phone_authority.sql
@@ -0,0 +1,135 @@
+-- Forward BODY. Deploy with the corresponding verify-login-otp change, not independently.
+-- No alias-derived account reassignment; ambiguous/unverified historical records need recovery.
+begin;
+set local lock_timeout = '5s';
+set local statement_timeout = '30s';
+
+create or replace function public._mobio_verified_phone_owner(p_phone text)
+returns uuid language plpgsql security definer set search_path='' as $$
+declare candidate auth.users%rowtype; matches integer;
+begin
+  if coalesce(p_phone,'') !~ '^\+[1-9][0-9]{7,14}$' then
+    raise exception 'INVALID_VERIFIED_PHONE' using errcode='22023';
+  end if;
+  select count(*) into matches from auth.users u
+  where u.phone in (p_phone, substring(p_phone from 2));
+  if matches=0 then return null; end if;
+  if matches<>1 then raise exception 'AMBIGUOUS_PHONE_IDENTITY' using errcode='42501'; end if;
+  select * into strict candidate from auth.users u
+  where u.phone in (p_phone, substring(p_phone from 2));
+  if candidate.phone_confirmed_at is null or coalesce(candidate.is_anonymous,false)
+     or candidate.deleted_at is not null or candidate.banned_until>now() then
+    raise exception 'PHONE_IDENTITY_UNAVAILABLE' using errcode='42501';
+  end if;
+  return candidate.id;
+end $$;
+revoke all on function public._mobio_verified_phone_owner(text) from public, anon, authenticated;
+
+create or replace function public.rpc_lookup_verified_phone_owner(p_phone text)
+returns uuid language plpgsql security definer set search_path='' as $$
+begin
+  if not public._mobio_is_service_role() then
+    raise exception 'SERVICE_ROLE_REQUIRED' using errcode='42501';
+  end if;
+  return public._mobio_verified_phone_owner(p_phone);
+end $$;
+revoke all on function public.rpc_lookup_verified_phone_owner(text) from public, anon, authenticated;
+grant execute on function public.rpc_lookup_verified_phone_owner(text) to service_role;
+
+-- Trigger checks request role, not current_user: a client-invoked SECURITY DEFINER
+-- profile RPC must not bypass protection of authoritative fields.
+create or replace function public.fn_guard_profile_identity_authority()
+returns trigger language plpgsql security definer set search_path='' as $$
+declare request_role text := coalesce(
+  nullif(current_setting('request.jwt.claim.role',true),''),
+  nullif(current_setting('request.jwt.claims',true),'')::jsonb->>'role','');
+begin
+  if request_role='service_role' or (request_role='' and session_user in ('postgres','supabase_admin')) then
+    return new;
+  end if;
+  if new.id is distinct from old.id or new.created_at is distinct from old.created_at
+     or new.phone is distinct from old.phone
+     or new.whatsapp_e164 is distinct from old.whatsapp_e164
+     or new.whatsapp_verified_at is distinct from old.whatsapp_verified_at
+     or new.auth_provider is distinct from old.auth_provider
+     or new.member_id is distinct from old.member_id then
+    raise exception 'VERIFIED_IDENTITY_FIELDS_READ_ONLY' using errcode='42501';
+  end if;
+  return new;
+end $$;
+revoke all on function public.fn_guard_profile_identity_authority() from public, anon, authenticated;
+drop trigger if exists guard_profile_identity_authority on public.profiles;
+create trigger guard_profile_identity_authority before update on public.profiles
+for each row execute function public.fn_guard_profile_identity_authority();
+
+-- Discovery must resolve the same verified Auth authority, not an editable alias.
+-- Full function body appended below, preserving manual/link and private-grant behavior.
+create or replace function public.fn_biopay_discover(p_user uuid,p_input jsonb)
+returns jsonb language plpgsql security definer set search_path = '' as $$
+declare l public.biopay_links; result jsonb; v_phone text; verified_owner uuid; manual jsonb; legacy public.biopay_payment_requests; legacy_match text[];
+begin
+  if coalesce(p_input->>'link_token','') <> '' then
+    select * into l from public.biopay_links where token=p_input->>'link_token'
+      and revoked_at is null and expires_at > now();
+    if not found then raise exception 'Link unavailable. Ask for a new link.'; end if;
+    select coalesce(jsonb_agg(public.fn_biopay_receiving_method(m) order by m.id),'[]') into result
+      from public.biopay_payment_methods m where m.id=any(l.method_ids)
+      and m.owner_id=l.owner_id and m.active and m.can_receive
+      and m.version=(l.method_versions->>m.id::text)::integer;
+    if jsonb_array_length(result) <> cardinality(l.method_ids) then
+      raise exception 'Receiving details changed. Ask for a new link.';
+    end if;
+    return jsonb_build_object('label',l.label,'methods',result,'assurance','sharedLink',
+      'link_token',l.token,'fixed_amount',l.amount_rwf,'purpose',l.purpose,'reference',l.reference,'link_version',l.version);
+  end if;
+  if coalesce(p_input->>'lookup','') like 'legacy:%' then
+    select * into legacy from public.biopay_payment_requests
+      where token=substring(p_input->>'lookup' from 8) and discovery_quote_id is null
+      and expires_at>now() and status not in ('expired','cancelled','failed','confirmed');
+    if not found then raise exception 'Legacy request unavailable. Ask for a new link.'; end if;
+    legacy_match:=regexp_match(legacy.ussd_code,'^\*182\*(1\*1|8\*1)\*([0-9+]+)(?:\*([0-9]+))?#$');
+    if legacy_match is null then raise exception 'Enter receiving details for this legacy request.'; end if;
+    manual:=jsonb_build_object('provider','mtn_rw','kind',case when legacy_match[1]='8*1' then 'merchantCode' else 'mobileWallet' end,
+      'identifier',case when legacy_match[1]='8*1' then legacy_match[2]
+      when legacy_match[2] ~ '^07[0-9]{8}$' then '+250'||substring(legacy_match[2] from 2)
+      when legacy_match[2] ~ '^2507[0-9]{8}$' then '+'||legacy_match[2] else legacy_match[2] end);
+    result:=public.fn_biopay_discover(p_user,jsonb_build_object('manual_method',manual));
+    if legacy.amount_minor>0 and legacy.amount_minor%100<>0 then raise exception 'Unsupported legacy amount.'; end if;
+    return result||jsonb_build_object('fixed_amount',nullif(legacy.amount_minor/100,0),
+      'purpose',case when legacy_match[1]='8*1' then 'merchant' else 'transfer' end);
+  end if;
+  manual := p_input->'manual_method';
+  if jsonb_typeof(manual)='object' then
+    if coalesce(manual->>'provider','') !~ '^[a-z0-9_]{2,32}$'
+      or coalesce(manual->>'kind','') not in ('mobileWallet','merchantCode','bankAccount','bankAlias')
+      or length(coalesce(manual->>'identifier','')) not between 3 and 40
+      or (manual->>'kind'='mobileWallet' and manual->>'identifier' !~ '^\+2507[0-9]{8}$')
+      or (manual->>'kind'='merchantCode' and manual->>'identifier' !~ '^[0-9]{3,20}$')
+      or (manual->>'kind' in ('bankAccount','bankAlias') and manual->>'identifier' !~ '^[A-Za-z0-9 -]{3,40}$')
+    then raise exception 'Check the receiving details.'; end if;
+    -- Never accept supplied owner, assurance, send role or destination version.
+    return jsonb_build_object('label','Entered receiving details','assurance','manual',
+      'methods',jsonb_build_array(jsonb_build_object('id','manual','owner_id','',
+        'provider',manual->>'provider','kind',manual->>'kind','identifier',manual->>'identifier',
+        'label','Entered receiving details','can_receive',true,'active',true,'version',0)));
+  end if;
+  v_phone := p_input->>'lookup';
+  -- No distinction between private, unavailable and absent recipient in public output.
+  begin
+    verified_owner := public._mobio_verified_phone_owner(v_phone);
+  exception when sqlstate '42501' or sqlstate '22023' then
+    verified_owner := null;
+  end;
+  -- Identical no-results response for private and nonexistent profiles.
+  select coalesce(jsonb_agg(public.fn_biopay_receiving_method(m) order by m.id),'[]') into result
+    from public.biopay_payment_methods m join public.profiles p on p.id=m.owner_id
+    where m.active and m.can_receive and p.id=verified_owner
+    and (m.owner_id=p_user or m.phone_discoverable or exists(
+      select 1 from public.biopay_method_grants g where g.method_id=m.id and g.grantee_id=p_user));
+  return jsonb_build_object('label','Shared receiving details','assurance','shared',
+    'lookup',v_phone,'methods',result);
+end $$;
+
+revoke all on function public.fn_biopay_discover(uuid,jsonb) from public,anon,authenticated;
+notify pgrst, 'reload schema';
+commit;
diff --git a/supabase/hardening/2026-09-28/03_strict_receipt_allocation.sql b/supabase/hardening/2026-09-28/03_strict_receipt_allocation.sql
new file mode 100644
index 0000000000000000000000000000000000000000..1a225d625512655e2e733190e8ba54c559591223
--- /dev/null
+++ b/supabase/hardening/2026-09-28/03_strict_receipt_allocation.sql
@@ -0,0 +1,259 @@
+-- Forward BODY: default-off, per-collector allocation policy; exact invoice/merchant evidence.
+-- This file has NOT been executed against PostgreSQL in this implementation environment.
+begin;
+set local lock_timeout='5s';
+set local statement_timeout='30s';
+
+create table if not exists public.momobio_allocation_policies (
+  collector_id uuid primary key references public.momobio_collectors(id) on delete cascade,
+  enabled boolean not null default false,
+  allowed_senders text[] not null default '{}',
+  merchant_codes text[] not null default '{}',
+  min_confidence numeric not null default 0.95 check(min_confidence between 0.95 and 1),
+  evidence_policy text not null default 'mtn-en-received-invoice-v1'
+    check(evidence_policy='mtn-en-received-invoice-v1'),
+  acceptance_record text,
+  updated_at timestamptz not null default now(),
+  check(not enabled or (cardinality(allowed_senders)>0 and cardinality(merchant_codes)>0
+    and length(trim(coalesce(acceptance_record,'')))>0))
+);
+alter table public.momobio_allocation_policies enable row level security;
+revoke all on public.momobio_allocation_policies from public,anon,authenticated;
+grant select,insert,update,delete on public.momobio_allocation_policies to service_role;
+-- NO enabled policy or guessed merchant is seeded by this migration.
+
+create or replace function public.rpc_ingest_driver_subscription_momo_sms(
+  p_raw_sms text, p_sender text default null, p_received_at timestamptz default null,
+  p_parsed jsonb default '{}'::jsonb
+) returns json language plpgsql security definer set search_path='' as $$
+declare
+  v_raw text:=nullif(trim(coalesce(p_raw_sms,'')),'');
+  v_sender text:=nullif(trim(coalesce(p_sender,'')),'');
+  v_parsed jsonb:=coalesce(p_parsed,'{}'::jsonb);
+  v_hash text; v_reference text; v_provider_ref text; v_merchant text;
+  v_collector uuid; v_amount bigint; v_confidence numeric;
+  v_policy public.momobio_allocation_policies%rowtype;
+  v_receipt public.driver_subscription_momo_sms_receipts%rowtype;
+  v_existing public.driver_subscription_momo_sms_receipts%rowtype;
+  v_request public.driver_subscription_payment_requests%rowtype;
+  v_reason text; v_parts text[]; v_count integer; v_explicit text;
+  v_subscription uuid;
+begin
+  -- Automatic allocation is a signed-collector server operation, not a direct admin-client RPC.
+  if not public._mobio_is_service_role() then
+    raise exception 'SERVICE_ROLE_REQUIRED' using errcode='42501';
+  end if;
+  if v_raw is null or length(v_raw)>10000 or v_sender is null or length(v_sender)>100
+    or p_received_at is null then
+    raise exception 'INVALID_SMS_ENVELOPE' using errcode='22023';
+  end if;
+  v_hash:=encode(extensions.digest(v_raw||'|'||v_sender,'sha256'),'hex');
+  perform pg_advisory_xact_lock(hashtextextended('momo-sms:'||v_hash,0));
+  select * into v_receipt from public.driver_subscription_momo_sms_receipts where sms_hash=v_hash;
+  if found then
+    return json_build_object('id',v_receipt.id,'status',v_receipt.status,'duplicate',true,
+      'matched_payment_request_id',v_receipt.matched_payment_request_id);
+  end if;
+
+  v_reference:=upper(nullif(trim(v_parsed->>'reference_code'),''));
+  v_provider_ref:=nullif(trim(v_parsed->>'provider_transaction_ref'),'');
+  v_merchant:=nullif(trim(v_parsed->>'momo_pay_code'),'');
+  if coalesce(v_parsed->>'verified_collector_id','') ~ '^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$' then
+    v_collector:=(v_parsed->>'verified_collector_id')::uuid;
+  end if;
+  select * into v_policy from public.momobio_allocation_policies
+    where collector_id=v_collector and enabled for share;
+  if not found then v_reason:='allocation_policy_disabled_or_missing'; end if;
+  perform 1 from public.momobio_collectors
+    where id=v_collector and revoked_at is null and expires_at>now() for share;
+  if not found then v_reason:='collector_unavailable'; end if;
+  if not exists(select 1 from unnest(v_policy.allowed_senders) as s(value)
+    where lower(trim(value))=lower(v_sender)) then v_reason:='sender_not_approved'; end if;
+  if v_merchant is null or v_merchant !~ '^[0-9]{3,20}$'
+    or not coalesce(v_merchant=any(v_policy.merchant_codes),false) then v_reason:='merchant_not_approved'; end if;
+  if v_parsed->'is_momo_payment' is distinct from 'true'::jsonb
+    or v_parsed->'allocation_eligible' is distinct from 'true'::jsonb
+    or v_parsed->>'evidence_policy' is distinct from 'mtn-en-received-invoice-v1' then
+    v_reason:='payment_evidence_required';
+  end if;
+  if jsonb_typeof(v_parsed->'confidence')='number' then
+    v_confidence:=(v_parsed->>'confidence')::numeric;
+  end if;
+  if v_confidence is null or v_confidence<coalesce(v_policy.min_confidence,0.95) or v_confidence>1 then
+    v_reason:='classification_evidence_insufficient';
+  end if;
+  if jsonb_typeof(v_parsed->'amount_rwf')='number'
+    and coalesce(v_parsed->>'amount_rwf','') ~ '^[1-9][0-9]{0,15}$' then
+    if (v_parsed->>'amount_rwf')::numeric<=9007199254740991 then
+      v_amount:=(v_parsed->>'amount_rwf')::bigint;
+    end if;
+  end if;
+  if v_amount is null then v_reason:='invalid_amount'; end if;
+  if v_reference is null or v_reference !~ '^[0-9]{6}-[A-Z0-9]{8}$' then v_reason:='invoice_reference_required'; end if;
+  if v_provider_ref is null or v_provider_ref !~ '^[A-Za-z0-9][A-Za-z0-9._-]{5,79}$' then v_reason:='provider_reference_required'; end if;
+  if p_received_at>now()+interval '5 minutes' then v_reason:='future_receipt_timestamp'; end if;
+
+  -- Independent raw-field corroboration. No amount/time-only or suffix-based fallback.
+  v_parts:=regexp_match(v_raw,'^\s*You have received\s+([0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)\s+(RWF|FRW)\M','i');
+  if v_parts is null then v_reason:='raw_amount_currency_unproven';
+  elsif replace(v_parts[1],',','')::numeric is distinct from v_amount::numeric then
+    v_reason:='raw_amount_currency_unproven';
+  end if;
+  select count(*),min(upper(parts[1])) into v_count,v_explicit
+    from regexp_matches(v_raw,'\m(?:Reference|Code)\s*[:#]?\s*([0-9]{6}-[A-Za-z0-9]{8})\M','gi') as m(parts);
+  if v_count<>1 or v_explicit is distinct from v_reference then v_reason:='raw_invoice_unproven'; end if;
+  select count(*),min(regexp_replace(parts[1],'[.,;:]+$','')) into v_count,v_explicit
+    from regexp_matches(v_raw,'\m(?:TxId|TxnId|Transaction\s+Id)\s*[:#]?\s*([A-Za-z0-9][A-Za-z0-9._-]{5,79})','gi') as m(parts);
+  if v_count<>1 or v_explicit is distinct from v_provider_ref then v_reason:='raw_provider_reference_unproven'; end if;
+  select count(*),min(parts[1]) into v_count,v_explicit
+    from regexp_matches(v_raw,'\m(?:Payee\s+code|Merchant\s+code)\s*[:#]?\s*([0-9]{3,20})\M','gi') as m(parts);
+  if v_count<>1 or v_explicit is distinct from v_merchant then v_reason:='raw_merchant_unproven'; end if;
+
+  if v_reason is null then
+    perform pg_advisory_xact_lock(hashtextextended('momo-tx:'||v_provider_ref,0));
+    select * into v_existing from public.driver_subscription_momo_sms_receipts
+      where provider_transaction_ref=v_provider_ref;
+    if found then
+      if v_existing.reference_code=v_reference and v_existing.amount_rwf=v_amount
+        and v_existing.momo_pay_code=v_merchant then
+        return json_build_object('id',v_existing.id,'status',v_existing.status,'duplicate',true,
+          'matched_payment_request_id',v_existing.matched_payment_request_id);
+      end if;
+      v_reason:='provider_reference_already_bound';
+    end if;
+  end if;
+  if v_reason is null then
+    select * into v_request from public.driver_subscription_payment_requests
+      where reference_code=v_reference for update;
+    if not found then v_reason:='invoice_unavailable';
+    elsif v_request.payment_method<>'momo_ussd' or v_request.status not in ('pending','dialer_opened') then
+      v_reason:='invoice_not_pending';
+    elsif v_request.amount_rwf<>v_amount or v_request.currency<>'RWF' or v_request.momo_pay_code<>v_merchant then
+      v_reason:='invoice_amount_currency_or_merchant_mismatch';
+    elsif p_received_at<v_request.created_at or p_received_at>v_request.expires_at then
+      v_reason:='invoice_time_mismatch';
+    end if;
+  end if;
+  if v_reason is not null then
+    -- Unproven references do not reserve the unique provider reference or create credit.
+    insert into public.driver_subscription_momo_sms_receipts(raw_sms,sms_hash,sender,received_at,momo_pay_code,status,metadata)
+    values(v_raw,v_hash,v_sender,p_received_at,'','unmatched',jsonb_build_object(
+      'review_required',true,'review_reason',v_reason,'verified_collector_id',v_collector,
+      'evidence_policy','mtn-en-received-invoice-v1')) returning * into v_receipt;
+    return json_build_object('id',v_receipt.id,'status','unmatched','review_required',true);
+  end if;
+
+  insert into public.driver_subscription_momo_sms_receipts(raw_sms,sms_hash,sender,received_at,
+    amount_rwf,momo_pay_code,reference_code,provider_transaction_ref,status,matched_payment_request_id,metadata)
+  values(v_raw,v_hash,v_sender,p_received_at,v_amount,v_merchant,v_reference,v_provider_ref,'matched',v_request.id,
+    jsonb_build_object('verified_collector_id',v_collector,'evidence_policy','mtn-en-received-invoice-v1'))
+  returning * into v_receipt;
+  update public.driver_subscription_payment_requests set status='confirmed',confirmed_at=p_received_at,
+    confirmation_source='momo_sms_bridge',provider_transaction_ref=v_provider_ref,
+    metadata=metadata||jsonb_build_object('momo_sms_receipt_id',v_receipt.id),updated_at=now()
+    where id=v_request.id;
+  v_subscription:=public._activate_driver_subscription(v_request.id,'momo_sms_bridge');
+  return json_build_object('id',v_receipt.id,'status','matched','reference_code',v_reference,
+    'matched_payment_request_id',v_request.id,'subscription_id',v_subscription);
+end $$;
+revoke all on function public.rpc_ingest_driver_subscription_momo_sms(text,text,timestamptz,jsonb) from public,anon,authenticated;
+grant execute on function public.rpc_ingest_driver_subscription_momo_sms(text,text,timestamptz,jsonb) to service_role;
+
+-- Current activation function with a shared entitlement lock added before period calculation.
+create or replace function public._activate_driver_subscription(
+  p_request_id uuid,
+  p_confirmation_source text
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_request public.driver_subscription_payment_requests%rowtype;
+  v_plan public.subscription_plans%rowtype;
+  v_start timestamptz;
+  v_end timestamptz;
+  v_subscription_id uuid;
+begin
+  select *
+  into v_request
+  from public.driver_subscription_payment_requests
+  where id = p_request_id
+  for update;
+
+  if not found then
+    raise exception using message = 'SUBSCRIPTION_PAYMENT_NOT_FOUND';
+  end if;
+
+  if v_request.status <> 'confirmed' then
+    raise exception using message = 'SUBSCRIPTION_PAYMENT_NOT_CONFIRMED';
+  end if;
+
+  -- Different paid invoices lock the same entitlement before reading/adding periods.
+  perform pg_advisory_xact_lock(hashtextextended(
+    'driver-entitlement:'||v_request.profile_id::text||':'||v_request.vehicle_type_id,0));
+
+  -- The locked invoice can activate once even if trusted callers retry.
+  select id into v_subscription_id from public.driver_subscriptions
+  where external_subscription_id=v_request.reference_code
+    and profile_id=v_request.profile_id
+  order by created_at limit 1;
+  if v_subscription_id is not null then return v_subscription_id; end if;
+
+  select *
+  into v_plan
+  from public.subscription_plans
+  where id = v_request.plan_id;
+
+  if not found then
+    raise exception using message = 'SUBSCRIPTION_PLAN_NOT_FOUND';
+  end if;
+
+  select greatest(now(), coalesce(max(current_period_end), now()))
+  into v_start
+  from public.driver_subscriptions
+  where profile_id = v_request.profile_id
+    and vehicle_type_id = v_request.vehicle_type_id
+    and status in ('trialing', 'active')
+    and current_period_end > now();
+
+  v_end := v_start + make_interval(days => v_plan.interval_days);
+
+  insert into public.driver_subscriptions (
+    profile_id,
+    plan_id,
+    vehicle_type_id,
+    tier,
+    status,
+    current_period_start,
+    current_period_end,
+    provider,
+    external_subscription_id,
+    metadata
+  )
+  values (
+    v_request.profile_id,
+    v_request.plan_id,
+    v_request.vehicle_type_id,
+    coalesce(v_plan.tier, 'plus'),
+    'active',
+    v_start,
+    v_end,
+    v_request.payment_method,
+    v_request.reference_code,
+    jsonb_build_object(
+      'payment_request_id', v_request.id,
+      'confirmation_source', p_confirmation_source
+    )
+  )
+  returning id into v_subscription_id;
+
+  return v_subscription_id;
+end;
+$$
+;
+
+revoke all on function public._activate_driver_subscription(uuid,text) from public,anon,authenticated;
+notify pgrst, 'reload schema';
+commit;
diff --git a/supabase/hardening/2026-09-28/04_canonical_member_id.sql b/supabase/hardening/2026-09-28/04_canonical_member_id.sql
new file mode 100644
index 0000000000000000000000000000000000000000..0c7163ca1b52eaf495245e8643ff041f90f055a3
--- /dev/null
+++ b/supabase/hardening/2026-09-28/04_canonical_member_id.sql
@@ -0,0 +1,117 @@
+-- Forward BODY. Generate a real Supabase migration with scripts/ci/prepare_hardening_migrations.py.
+-- Canonical six-digit Mobio member IDs: unique, server-managed and collision-safe.
+begin;
+set local lock_timeout = '5s';
+set local statement_timeout = '60s';
+
+-- Normalize historical invalid values before enforcing the format.
+update public.profiles
+set member_id = null
+where member_id is not null
+  and member_id !~ '^[0-9]{6}$';
+
+-- Keep the oldest owner of a duplicated historical ID and reassign the rest.
+with ranked as (
+  select id,
+         row_number() over (
+           partition by member_id
+           order by created_at nulls last, id
+         ) as rn
+  from public.profiles
+  where member_id is not null
+)
+update public.profiles p
+set member_id = null
+from ranked r
+where p.id = r.id
+  and r.rn > 1;
+
+create or replace function public._mobio_allocate_member_id()
+returns text
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  candidate text;
+  attempts integer := 0;
+begin
+  -- Serialize this very small allocation critical section. The unique index below
+  -- remains the final invariant; the lock avoids check-then-insert races.
+  perform pg_catalog.pg_advisory_xact_lock(636624648, 1);
+  loop
+    attempts := attempts + 1;
+    if attempts > 900000 then
+      raise exception 'MEMBER_ID_SPACE_EXHAUSTED' using errcode = '54000';
+    end if;
+    candidate := pg_catalog.lpad((100000 + pg_catalog.floor(random() * 900000)::integer)::text, 6, '0');
+    exit when not exists (
+      select 1 from public.profiles p where p.member_id = candidate
+    );
+  end loop;
+  return candidate;
+end
+$$;
+revoke all on function public._mobio_allocate_member_id() from public, anon, authenticated;
+
+-- Backfill every row through separate commands so each allocation observes prior assignments.
+do $backfill$
+declare
+  row_to_fix record;
+begin
+  for row_to_fix in
+    select id from public.profiles where member_id is null order by created_at nulls last, id
+  loop
+    update public.profiles
+    set member_id = public._mobio_allocate_member_id()
+    where id = row_to_fix.id;
+  end loop;
+end
+$backfill$;
+
+create unique index if not exists profiles_member_id_unique
+  on public.profiles(member_id);
+
+alter table public.profiles
+  drop constraint if exists profiles_member_id_format_check;
+alter table public.profiles
+  add constraint profiles_member_id_format_check
+  check (member_id ~ '^[0-9]{6}$');
+alter table public.profiles
+  alter column member_id set not null;
+
+create or replace function public.fn_assign_mobio_member_id()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  request_role text := coalesce(
+    nullif(current_setting('request.jwt.claim.role', true), ''),
+    nullif(current_setting('request.jwt.claims', true), '')::jsonb->>'role',
+    ''
+  );
+begin
+  -- Client inserts never choose their public identifier. Trusted import/migration
+  -- contexts may preserve a supplied unique six-digit value.
+  if request_role <> 'service_role'
+     and not (request_role = '' and session_user in ('postgres', 'supabase_admin')) then
+    new.member_id := public._mobio_allocate_member_id();
+  elsif new.member_id is null then
+    new.member_id := public._mobio_allocate_member_id();
+  elsif new.member_id !~ '^[0-9]{6}$' then
+    raise exception 'INVALID_MEMBER_ID' using errcode = '22023';
+  end if;
+  return new;
+end
+$$;
+revoke all on function public.fn_assign_mobio_member_id() from public, anon, authenticated;
+
+drop trigger if exists assign_mobio_member_id on public.profiles;
+create trigger assign_mobio_member_id
+before insert on public.profiles
+for each row execute function public.fn_assign_mobio_member_id();
+
+notify pgrst, 'reload schema';
+commit;
diff --git a/supabase/hardening/2026-09-28/05_transport_hold_receipt_integrity.sql b/supabase/hardening/2026-09-28/05_transport_hold_receipt_integrity.sql
new file mode 100644
index 0000000000000000000000000000000000000000..cbcb095246f0fe49b1a617fbf2528266b87ef67f
--- /dev/null
+++ b/supabase/hardening/2026-09-28/05_transport_hold_receipt_integrity.sql
@@ -0,0 +1,226 @@
+-- Forward BODY. Rehearse with real PostgreSQL/PostgREST before deployment.
+-- Makes seat holds idempotent per passenger/schedule, releases expired holds,
+-- and binds a provider receipt to exactly one booking before confirming inventory.
+begin;
+set local lock_timeout = '5s';
+set local statement_timeout = '60s';
+
+create or replace function public._mobio_release_expired_bus_holds(p_schedule_id uuid default null)
+returns integer
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  released_count integer := 0;
+  hold_row record;
+begin
+  for hold_row in
+    select b.id, b.schedule_id, b.seat_count
+    from public.bus_bookings b
+    where b.status = 'held'
+      and b.payment_status = 'pending'
+      and b.hold_expires_at is not null
+      and b.hold_expires_at <= timezone('utc', now())
+      and (p_schedule_id is null or b.schedule_id = p_schedule_id)
+    order by b.schedule_id, b.id
+    for update skip locked
+  loop
+    update public.bus_bookings b
+    set status = 'expired', updated_at = timezone('utc', now())
+    where b.id = hold_row.id and b.status = 'held';
+    if found then
+      update public.bus_seat_inventory i
+      set available_seats = least(i.total_seats, i.available_seats + hold_row.seat_count),
+          held_seats = greatest(i.held_seats - hold_row.seat_count, 0),
+          updated_at = timezone('utc', now())
+      where i.schedule_id = hold_row.schedule_id;
+      released_count := released_count + 1;
+    end if;
+  end loop;
+  return released_count;
+end
+$$;
+revoke all on function public._mobio_release_expired_bus_holds(uuid) from public, anon, authenticated;
+grant execute on function public._mobio_release_expired_bus_holds(uuid) to service_role;
+
+create or replace function public.rpc_hold_bus_seats(
+  p_schedule_id uuid,
+  p_seat_count integer,
+  p_seat_numbers jsonb default '[]'::jsonb,
+  p_passenger_name text default null,
+  p_passenger_phone text default null
+)
+returns table (booking_id uuid,ticket_reference text,status text,payment_status text,hold_expires_at timestamptz,amount numeric,currency text)
+language plpgsql security definer set search_path = '' as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_schedule public.bus_schedules%rowtype;
+  v_inventory public.bus_seat_inventory%rowtype;
+  v_booking public.bus_bookings%rowtype;
+  v_hold_expires_at timestamptz := timezone('utc', now()) + interval '10 minutes';
+begin
+  if v_user_id is null then raise exception 'Please sign in to book a seat.'; end if;
+  if p_schedule_id is null or p_seat_count is null or p_seat_count < 1 or p_seat_count > 20 then
+    raise exception 'Invalid seat hold request.';
+  end if;
+
+  select s.* into v_schedule from public.bus_schedules s
+  where s.id=p_schedule_id and s.status in ('scheduled','boarding')
+    and (s.booking_cutoff_at is null or s.booking_cutoff_at > timezone('utc',now()))
+  for update;
+  if not found then raise exception 'Schedule is not available for booking.'; end if;
+
+  perform public._mobio_release_expired_bus_holds(p_schedule_id);
+
+  -- Schedule row lock serializes competing holds. Return an equivalent active hold
+  -- instead of decrementing inventory again on client retry.
+  select b.* into v_booking from public.bus_bookings b
+  where b.schedule_id=p_schedule_id and b.passenger_id=v_user_id
+    and b.status='held' and b.payment_status='pending'
+    and (b.hold_expires_at is null or b.hold_expires_at > timezone('utc',now()))
+  order by b.created_at desc
+  limit 1;
+  if found then
+    if v_booking.seat_count <> p_seat_count
+       or coalesce(v_booking.seat_numbers,'[]'::jsonb) <> coalesce(p_seat_numbers,'[]'::jsonb) then
+      raise exception 'An active hold already exists for this schedule.' using errcode='23505';
+    end if;
+    return query select v_booking.id,v_booking.ticket_reference,v_booking.status,
+      v_booking.payment_status,v_booking.hold_expires_at,v_booking.amount,v_booking.currency;
+    return;
+  end if;
+
+  select i.* into v_inventory from public.bus_seat_inventory i
+  where i.schedule_id=p_schedule_id for update;
+  if not found or v_inventory.available_seats < p_seat_count then
+    raise exception 'Not enough seats are available.';
+  end if;
+
+  update public.bus_seat_inventory i
+  set available_seats=i.available_seats-p_seat_count,
+      held_seats=i.held_seats+p_seat_count,
+      updated_at=timezone('utc',now())
+  where i.schedule_id=p_schedule_id;
+
+  insert into public.bus_bookings(schedule_id,agency_id,organization_id,passenger_id,
+    passenger_name,passenger_phone,seat_count,seat_numbers,status,payment_status,
+    amount,currency,hold_expires_at,ticket_reference)
+  values(v_schedule.id,v_schedule.agency_id,v_schedule.organization_id,v_user_id,
+    nullif(trim(coalesce(p_passenger_name,'')),''),nullif(trim(coalesce(p_passenger_phone,'')),''),
+    p_seat_count,coalesce(p_seat_numbers,'[]'::jsonb),'held','pending',
+    v_schedule.fare_amount*p_seat_count,v_schedule.currency,v_hold_expires_at,
+    public.mobio_public_transport_ticket_reference())
+  returning * into v_booking;
+
+  return query select v_booking.id,v_booking.ticket_reference,v_booking.status,
+    v_booking.payment_status,v_booking.hold_expires_at,v_booking.amount,v_booking.currency;
+end $$;
+
+create or replace function public.rpc_confirm_bus_booking(
+  p_booking_id uuid,p_payment_provider text,p_provider_reference text,p_metadata jsonb default '{}'::jsonb
+)
+returns table (booking_id uuid,ticket_reference text,status text,payment_status text,amount numeric,currency text)
+language plpgsql security definer set search_path = '' as $$
+declare
+  v_booking public.bus_bookings%rowtype;
+  v_existing_payment public.bus_booking_payments%rowtype;
+  v_provider text := nullif(trim(coalesce(p_payment_provider,'')),'');
+  v_reference text := nullif(trim(coalesce(p_provider_reference,'')),'');
+begin
+  if v_provider is null or v_reference is null or length(v_reference)>200 then
+    raise exception 'PAYMENT_REFERENCE_REQUIRED' using errcode='22023';
+  end if;
+
+  select b.* into v_booking from public.bus_bookings b where b.id=p_booking_id for update;
+  if not found then raise exception 'Booking is not available for confirmation.'; end if;
+  if not (coalesce(current_setting('request.jwt.claim.role',true),'')='service_role'
+      or public.can_access_organization(v_booking.organization_id,'transport.bookings.manage')) then
+    raise exception 'Payment confirmation requires agency or service authorization.';
+  end if;
+
+  select p.* into v_existing_payment from public.bus_booking_payments p
+  where p.provider=v_provider and p.provider_reference=v_reference for update;
+  if found and v_existing_payment.booking_id <> v_booking.id then
+    raise exception 'PAYMENT_REFERENCE_ALREADY_USED' using errcode='23505';
+  end if;
+
+  if v_booking.status='confirmed' and v_booking.payment_status='paid' then
+    if not found then raise exception 'BOOKING_ALREADY_CONFIRMED_WITH_DIFFERENT_RECEIPT' using errcode='23505'; end if;
+    return query select v_booking.id,v_booking.ticket_reference,v_booking.status,
+      v_booking.payment_status,v_booking.amount,v_booking.currency;
+    return;
+  end if;
+  if v_booking.status<>'held' or v_booking.payment_status<>'pending' then
+    raise exception 'Booking is not available for confirmation.';
+  end if;
+
+  if v_booking.hold_expires_at is not null and v_booking.hold_expires_at <= timezone('utc',now()) then
+    update public.bus_bookings b set status='expired',updated_at=timezone('utc',now()) where b.id=v_booking.id;
+    update public.bus_seat_inventory i
+      set available_seats=least(i.total_seats,i.available_seats+v_booking.seat_count),
+          held_seats=greatest(i.held_seats-v_booking.seat_count,0),
+          updated_at=timezone('utc',now())
+      where i.schedule_id=v_booking.schedule_id;
+    v_booking.status := 'expired';
+    return query select v_booking.id,v_booking.ticket_reference,'expired'::text,
+      v_booking.payment_status,v_booking.amount,v_booking.currency;
+    return;
+  end if;
+
+  if v_existing_payment.id is null then
+    insert into public.bus_booking_payments(booking_id,organization_id,provider,provider_reference,
+      amount,currency,status,metadata)
+    values(v_booking.id,v_booking.organization_id,v_provider,v_reference,
+      v_booking.amount,v_booking.currency,'paid',coalesce(p_metadata,'{}'::jsonb))
+    returning * into v_existing_payment;
+  else
+    update public.bus_booking_payments p
+    set status='paid',metadata=coalesce(p_metadata,'{}'::jsonb),updated_at=timezone('utc',now())
+    where p.id=v_existing_payment.id;
+  end if;
+
+  update public.bus_seat_inventory i
+  set held_seats=greatest(i.held_seats-v_booking.seat_count,0),
+      confirmed_seats=i.confirmed_seats+v_booking.seat_count,
+      updated_at=timezone('utc',now())
+  where i.schedule_id=v_booking.schedule_id;
+
+  update public.bus_bookings b
+  set status='confirmed',payment_status='paid',updated_at=timezone('utc',now())
+  where b.id=v_booking.id returning * into v_booking;
+
+  return query select v_booking.id,v_booking.ticket_reference,v_booking.status,
+    v_booking.payment_status,v_booking.amount,v_booking.currency;
+end $$;
+
+revoke all on function public.rpc_hold_bus_seats(uuid,integer,jsonb,text,text) from public,anon;
+revoke all on function public.rpc_confirm_bus_booking(uuid,text,text,jsonb) from public,anon;
+grant execute on function public.rpc_hold_bus_seats(uuid,integer,jsonb,text,text) to authenticated;
+grant execute on function public.rpc_confirm_bus_booking(uuid,text,text,jsonb) to authenticated;
+
+-- A durable sweeper entry point. Scheduling is an operations decision and is not
+-- silently created here; production must bind this to the approved scheduler.
+create or replace function public.rpc_expire_bus_holds(p_limit integer default 500)
+returns integer language plpgsql security definer set search_path='' as $$
+declare total_released integer := 0; schedule_row record; released integer;
+begin
+  if coalesce(current_setting('request.jwt.claim.role',true),'') <> 'service_role' then
+    raise exception 'SERVICE_ROLE_REQUIRED' using errcode='42501';
+  end if;
+  for schedule_row in
+    select distinct b.schedule_id from public.bus_bookings b
+    where b.status='held' and b.payment_status='pending'
+      and b.hold_expires_at <= timezone('utc',now())
+    order by b.schedule_id limit least(greatest(coalesce(p_limit,500),1),5000)
+  loop
+    released := public._mobio_release_expired_bus_holds(schedule_row.schedule_id);
+    total_released := total_released + released;
+  end loop;
+  return total_released;
+end $$;
+revoke all on function public.rpc_expire_bus_holds(integer) from public,anon,authenticated;
+grant execute on function public.rpc_expire_bus_holds(integer) to service_role;
+
+notify pgrst, 'reload schema';
+commit;
diff --git a/supabase/hardening/2026-09-28/06_bounded_driver_discovery.sql b/supabase/hardening/2026-09-28/06_bounded_driver_discovery.sql
new file mode 100644
index 0000000000000000000000000000000000000000..cbda1d484f582616367b94d057372720389937cb
--- /dev/null
+++ b/supabase/hardening/2026-09-28/06_bounded_driver_discovery.sql
@@ -0,0 +1,106 @@
+-- Forward BODY. Bound nearby-driver discovery by freshness, distance and result count.
+begin;
+set local lock_timeout = '5s';
+set local statement_timeout = '30s';
+
+create or replace function public.rpc_search_nearby_drivers(
+  p_user_lat double precision,
+  p_user_lng double precision,
+  p_search_text text default null,
+  p_vehicle_type text default null,
+  p_limit integer default 20
+)
+returns table(
+  driver_id uuid, display_name text, vehicle_type_id text, plate_number text,
+  latitude double precision, longitude double precision, distance_km double precision,
+  whatsapp text, member_id text
+)
+language plpgsql security definer set search_path='' as $$
+begin
+  if coalesce(current_setting('request.jwt.claim.role',true),'') <> 'service_role'
+     and public.verified_app_user_id() is null then
+    raise exception 'Verified WhatsApp session required' using errcode='PT401';
+  end if;
+  if p_user_lat is null or p_user_lng is null
+     or p_user_lat not between -90 and 90 or p_user_lng not between -180 and 180 then
+    raise exception 'Valid coordinates required' using errcode='22023';
+  end if;
+  return query
+  with candidates as (
+    select dl.driver_id,coalesce(p.display_name,p.name) display_name,
+      coalesce(dl.vehicle_type_id::text,p.vehicle_type::text,'cab') vehicle_type_id,
+      p.vehicle_number_plate plate_number,dl.latitude,dl.longitude,
+      (6371 * acos(least(1,greatest(-1,
+        cos(radians(p_user_lat))*cos(radians(dl.latitude))*
+        cos(radians(dl.longitude)-radians(p_user_lng))+
+        sin(radians(p_user_lat))*sin(radians(dl.latitude))
+      )))) distance_km,p.whatsapp,p.member_id
+    from public.driver_locations dl
+    join public.profiles p on p.id=dl.driver_id
+    where dl.is_online=true
+      and dl.updated_at >= timezone('utc',now()) - interval '2 minutes'
+      and (p_vehicle_type is null or coalesce(dl.vehicle_type_id::text,p.vehicle_type::text)=p_vehicle_type)
+      and (p_search_text is null or p.name ilike '%'||p_search_text||'%'
+        or coalesce(p.display_name,'') ilike '%'||p_search_text||'%'
+        or coalesce(p.vehicle_number_plate,'') ilike '%'||p_search_text||'%')
+  )
+  select c.driver_id,c.display_name,c.vehicle_type_id,c.plate_number,c.latitude,c.longitude,
+    c.distance_km,c.whatsapp,c.member_id
+  from candidates c
+  where c.distance_km <= 10
+  order by c.distance_km asc
+  limit least(greatest(coalesce(p_limit,20),1),50);
+end $$;
+
+create or replace function public.rpc_get_discover_summary(
+  p_user_lat double precision default null,
+  p_user_lng double precision default null,
+  p_vehicle_type text default null
+)
+returns json language plpgsql security definer set search_path='' as $$
+declare result json; nearby_count integer; scheduled_count integer;
+begin
+  if coalesce(current_setting('request.jwt.claim.role',true),'') <> 'service_role'
+     and public.verified_app_user_id() is null then
+    raise exception 'Verified WhatsApp session required' using errcode='PT401';
+  end if;
+  if (p_user_lat is null) <> (p_user_lng is null) then
+    raise exception 'Both coordinates are required together' using errcode='22023';
+  end if;
+  if p_user_lat is not null then
+    select count(*) into nearby_count
+    from public.driver_locations dl
+    where dl.is_online=true
+      and dl.updated_at >= timezone('utc',now()) - interval '2 minutes'
+      and (p_vehicle_type is null or dl.vehicle_type_id::text=p_vehicle_type)
+      and (6371 * acos(least(1,greatest(-1,
+        cos(radians(p_user_lat))*cos(radians(dl.latitude))*
+        cos(radians(dl.longitude)-radians(p_user_lng))+
+        sin(radians(p_user_lat))*sin(radians(dl.latitude))
+      )))) <= 10;
+  else
+    nearby_count := 0; -- Never expose a global online-driver count without location context.
+  end if;
+  select count(*) into scheduled_count from public.trips t
+  where t.is_active=true and t.status='active'
+    and (p_vehicle_type is null or t.vehicle_type::text=p_vehicle_type);
+  result:=json_build_object('nearby_driver_count',nearby_count,'scheduled_trip_count',scheduled_count);
+  return result;
+end $$;
+
+-- Direct Data API reads may inspect only the caller's own row or an admin row.
+-- The SECURITY DEFINER RPC above is the bounded discovery interface.
+drop policy if exists driver_locations_online_read_authenticated on public.driver_locations;
+create policy driver_locations_online_read_authenticated on public.driver_locations
+for select to authenticated
+using (
+  driver_id=(select public.verified_app_user_id())
+  or (select public.is_platform_admin())
+);
+
+revoke execute on function public.rpc_search_nearby_drivers(double precision,double precision,text,text,integer) from public,anon;
+grant execute on function public.rpc_search_nearby_drivers(double precision,double precision,text,text,integer) to authenticated,service_role;
+revoke execute on function public.rpc_get_discover_summary(double precision,double precision,text) from public,anon;
+grant execute on function public.rpc_get_discover_summary(double precision,double precision,text) to authenticated,service_role;
+notify pgrst,'reload schema';
+commit;
diff --git a/supabase/hardening/2026-09-28/README.md b/supabase/hardening/2026-09-28/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..802ae38f1f8f0ce25392992ecbf00af96c78b802
--- /dev/null
+++ b/supabase/hardening/2026-09-28/README.md
@@ -0,0 +1,43 @@
+# Forward database hardening — integration required
+
+These six versioned SQL **bodies** are complete candidate forward changes, not applied migrations. No historical migration was edited. This implementation environment has no Supabase CLI/PostgreSQL runtime and the connected Supabase account exposes no projects, so source review and application fixtures do not prove SQL execution or deployment.
+
+## Prepare on a clean review branch
+
+1. Apply the supplied source patch to the matching baseline (or reconcile differing files first).
+2. Install the supported Supabase CLI and inspect `supabase migration new --help`.
+3. Run `python3 scripts/ci/prepare_hardening_migrations.py` for the read-only plan.
+4. After reviewing bodies and their checksums, run `python3 scripts/ci/prepare_hardening_migrations.py --write`. It invokes only `supabase migration new`, fills new empty files and preserves existing migration files. It does **not** link, push, reset or execute SQL.
+5. Run the same script with `--check`, then review and commit the generated migrations together with the Edge changes. The main CI backend lane and go/no-go helper deliberately block while these files are missing.
+6. Rehearse the complete migration chain and a sanitized forward-upgrade copy in isolation. Run `post_install_assertions.sql` there. Validate actual PostgREST roles, Auth and transactional behavior; catalog assertions alone are not acceptance.
+
+Do not invent timestamp filenames, modify an applied migration or deploy the new OTP handler before its verified-phone lookup RPC exists. An interrupted preparer leaves created files visible; inspect them rather than deleting history or forcing overwrite. A stale `.mobio-hardening-prepare.lock` requires manual inspection.
+
+## Behavior and compatibility
+
+**01 / Booking write authority.** Clients lose all direct booking mutation privileges, including column-level grants. Existing SELECT policies remain. Agency and consumer screens must use the existing authorized server operations; any direct-write agency path will be blocked. No new refund, cancellation or inventory sweeper is supplied here.
+
+**02 / Verified phone authority.** The authoritative lookup is `auth.users.phone` with a confirmed, nonanonymous, available account. Editable profile aliases no longer select login or phone-discovery recipients. Confirmed digits-only and leading-plus Auth representations are recognized without guessing a country. Duplicate/unconfirmed legacy records fail closed and need an approved recovery process. Identity fields cannot be modified through ordinary client requests or client-invoked profile RPCs. A verified phone-change workflow is not implemented by this patch; current attempts to mutate those fields will be rejected. Existing session issuance and real Auth collision behavior require rehearsal.
+
+**03 / Subscription receipts.** Automatic allocation is off by default in both Edge configuration and the new per-collector policy table. Enabling requires an approved collector, nonempty exact merchant and sender lists, an explicit acceptance-record reference, and the supported evidence policy. No example merchant or live acceptance record is seeded. The only proposed automatic template is the English MTN-style received-payment fixture with one explicit amount/currency, invoice reference, provider transaction reference and merchant code. It is NOT a certified operator format. Other languages/formats, ambiguous/nonpayment messages and absent fields are retained as unmatched for review; they cannot activate an entitlement. Confirm actual operator messages before enabling. Different invoices serialize by profile/vehicle entitlement; duplicate invoices remain idempotent. Real two-session READ COMMITTED, serialization failure/retry and duplicate-receipt tests remain required.
+
+
+**04 / Canonical member IDs.** Existing invalid or duplicate six-digit member identifiers are reconciled, then every profile receives one unique server-managed six-digit identifier. Ordinary clients cannot choose or mutate the identifier. The allocation trigger and unique constraint are defense in depth; production reconciliation must be reviewed before deployment because changing a duplicate legacy public identifier can affect external references.
+
+**05 / Transport hold and receipt integrity.** Equivalent active seat-hold retries are idempotent instead of consuming inventory twice. Expired holds restore inventory durably. Confirmation binds a provider/reference pair to exactly one booking before inventory is confirmed, and cross-booking receipt reuse is rejected. A service-only expiry sweeper entry point is provided but is not scheduled automatically.
+
+**06 / Bounded driver discovery.** Nearby discovery requires a verified application user, excludes stale location heartbeats, limits results to ten kilometres and fifty rows, and removes global direct online-location reads for ordinary authenticated users. Direct table reads are reduced to the caller's own row or platform-admin access; the bounded RPC is the discovery interface.
+
+## Required adversarial rehearsal
+
+Use only synthetic users, collectors, invoices and amounts in an isolated environment. Record exact schema and application revisions.
+
+- Passenger direct REST attempts to set paid/confirmed, seats, price, route, expiry and ownership are denied; legitimate hold/confirmation/cancellation still works through authorized operations.
+- Updating profile verified aliases, identity timestamps or IDs is denied for real authenticated clients and client-invoked RPCs; editable nonauthority profile fields still work.
+- Alias spoofing, banned/anonymous/unconfirmed and duplicate Auth phone records cannot select or reassign another identity. Existing-user login must not call phone reassignment. Verify actual new-user races and recovery behavior.
+- `anon` and `authenticated` cannot execute internal lookup/allocation functions or read policy records.
+- Negative classification, malformed amounts, absent provider/invoice IDs, wrong merchant/currency, unsupported sender/template, expired/revoked collector and missing acceptance record produce no credit.
+- Replaying one provider reference on the same invoice is idempotent; another invoice cannot consume it. Two concurrent renewals retain both paid durations; record transaction isolation and retry outcomes.
+- Fail between receipt write, invoice update and activation; verify atomic rollback. Confirm out-of-order offline receipts and lost acknowledgements do not cause silent false success.
+
+Known residual limits: parsing remains synchronous before durable intake; the collector still needs its own transactional queue, minimization and signing work. A reviewed receipt does not itself prove operator settlement. The institutional collection and data-handling approvals remain external prerequisites.
